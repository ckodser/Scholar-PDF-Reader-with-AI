: {"message": "\ud559\uc220\uac80\uc0c9 \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0 \uac15\uc870 \ud45c\uc2dc \ub610\ub294 \uc8fc\uc11d\uc744 \uc800\uc7a5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc800\uc7a5\ud574 \ubcf4\uaca0\uc2b5\ub2c8\ub2e4."}, "1804": {"message": "\uac15\uc870 \ud45c\uc2dc\uc640 \uc8fc\uc11d\uc744 \uc800\uc7a5\ud558\ub824\uba74 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc800\uc7a5\ud574 \ubcf4\uaca0\uc2b5\ub2c8\ub2e4."}, "1805": {"message": "\uac15\uc870 \ud45c\uc2dc\uc640 \uc8fc\uc11d\uc744 \uc800\uc7a5\ud558\ub824\uba74 \uae30\uae30\uc5d0\uc11c \uc5ec\uc720 \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uc138\uc694. \uadf8\ub7ec\uc9c0 \uc54a\uc73c\uba74 \ubcc0\uacbd\uc0ac\ud56d\uc774 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, "1806": {"message": "\ub3d9\uae30\ud654 \uc911..."}, "1807": {"message": "\ub3d9\uae30\ud654\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}, "1808": {"message": "\uac15\uc870 \ud45c\uc2dc\uc640 \uc8fc\uc11d\uc744 \ub3d9\uae30\ud654\ud558\ub294 \uc911\uc5d0 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4."}, "1809": {"message": "\uae30\uae30\uac00 \uc624\ud504\ub77c\uc778 \uc0c1\ud0dc\uc785\ub2c8\ub2e4."}, "1810": {"message": "\uac15\uc870 \ud45c\uc2dc\uc640 \uc8fc\uc11d\uc744 \ubcf4\ub824\uba74 \uc778\ud130\ub137\uc5d0 \uc5f0\uacb0\ud558\uc138\uc694."}, "1811": {"message": "\uac15\uc870 \ud45c\uc2dc\uc640 \uc8fc\uc11d\uc744 \ubcf4\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694."}, "1812": {"message": "\ubcc0\uacbd\uc0ac\ud56d\uc774 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."}, "1813": {"message": "AI \uac1c\uc694 \ubcf5\uc0ac"}, "1814": {"message": "$BOLD_ANCHOR_BEGIN$\ud559\uc220\uac80\uc0c9 PDF \ub9ac\ub354$BOLD_ANCHOR_END$\uc758 AI \uac1c\uc694", "placeholders": {"BOLD_ANCHOR_BEGIN": {"content": "$1"}, "BOLD_ANCHOR_END": {"content": "$2"}}}, "1815": {"message": "AI \uac1c\uc694\uac00 \ud074\ub9bd\ubcf4\ub4dc\uc5d0 \ubcf5\uc0ac\