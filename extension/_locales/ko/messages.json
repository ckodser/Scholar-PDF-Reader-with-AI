u00d7$PAGE_HEIGHT$\uc778\uce58($PAGE_SIZE_NAME$, $PAGE_ORIENTATION$)", "placeholders": {"PAGE_HEIGHT": {"content": "$1"}, "PAGE_ORIENTATION": {"content": "$2"}, "PAGE_SIZE_NAME": {"content": "$3"}, "PAGE_WIDTH": {"content": "$4"}}}, "1661": {"message": "$PAGE_WIDTH$\u00d7$PAGE_HEIGHT$mm($PAGE_SIZE_NAME$, $PAGE_ORIENTATION$)", "placeholders": {"PAGE_HEIGHT": {"content": "$1"}, "PAGE_ORIENTATION": {"content": "$2"}, "PAGE_SIZE_NAME": {"content": "$3"}, "PAGE_WIDTH": {"content": "$4"}}}, "1662": {"message": "Letter"}, "1663": {"message": "Legal"}, "1664": {"message": "\ud0c0\ube14\ub85c\uc774\ub4dc"}, "1668": {"message": "PDF \ubb38\uc11c\ub97c \ub85c\ub4dc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}, "1669": {"message": "\uc0c8\ub85c\uace0\uce68"}, "1670": {"message": "\uc624\ub958"}, "1673": {"message": "\ube44\ubc00\ubc88\ud638\ub97c \uc785\ub825\ud574\uc57c \ud569\ub2c8\ub2e4."}, "1674": {"message": "\ubb38\uc11c\uac00 \ube44\ubc00\ubc88\ud638\ub85c \ubcf4\ud638\ub418\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ube44\ubc00\ubc88\ud638\ub97c \uc785\ub825\ud558\uc138\uc694."}, "1675": {"message": "PDF \ubb38\uc11c\ub97c \uc778\uc1c4\ud558\ub824\uba74 \ud234\ubc14\uc5d0 \uc788\ub294 \uc778\uc1c4 \ubc84\ud2bc\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."}, "1676": {"message": "\ube44\ubc00\ubc88\ud638\uac00 \uc798\ubabb\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, "1677": {"message": "\ud559\uc220\uac80\uc0c9 PDF \ub9ac\ub354\uc5d0\uc11c\ub294 \uc544\uc9c1 \uc591\uc2dd \uc791\uc131\uc774 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."}, "1678": {"message": "Google \ud559\uc220\uac80\uc0c9 PDF \ub9ac\ub354"}, "1698": {"message": "\uac1c\uc694"}, "1702": {"message": "\ud559\uc220\uac80\uc0c9 \ub9ac\ub354 \uc0ac\uc6a9 \uc124\uc815"}, "1703": {"message": "Google \ud559\uc220\uac80\uc0c9 \ub9ac\ub354\ub85c \ub85c\uceec PDF\ub97c \uc77d\uc73c\ub824\uba74 \uc124\uc815\uc5d0\uc11c \ud30c\uc77c URL\uc5d0 \ub300\ud55c \uc561\uc138\uc2a4\ub97c \ud5c8\uc6a9\ud55c \ud6c4 \uc77d\uace0 \uc788\ub294 PDF\ub97c \u