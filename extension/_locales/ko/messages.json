\uc694\ub97c \uc0ac\uc6a9 \uc124\uc815\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?"}, "1751": {"message": "\uac1c\uc694\ub97c \ud45c\uc2dc\ud558\uae30 \uc704\ud574 \ub9ac\ub354\uac00 \ud559\uc220\uac80\uc0c9\uc5d0\uc11c PDF\ub97c \ucc3e\uc73c\ub824\uace0 \uc2dc\ub3c4\ud569\ub2c8\ub2e4."}, "1752": {"message": "AI \uac1c\uc694\uc5d0 \uad00\ud55c \uc815\ubcf4"}, "1753": {"message": "\uc790\ub8cc \uc139\uc158\uc758 \ud575\uc2ec \uc0ac\ud56d"}, "1754": {"message": "AI \uac1c\uc694\ub294 \ubb38\uc11c\uc758 \uc8fc\uc694 \uc139\uc158\uc5d0 \ub300\ud55c \uc8fc\uc694 \uc694\uc810\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, "1755": {"message": "\uac1c\uc694\ub97c \ud6d1\uc5b4\ubcf4\uac70\ub098 \uc138\ubd80\uc815\ubcf4\ub85c \uc774\ub3d9"}, "1756": {"message": "\ud575\uc2ec \uc0ac\ud56d\uc744 \ud6d1\uc5b4 \uac04\ub7b5\ud55c \uac1c\uc694\ub97c \ud655\uc778\ud558\uace0, \uad00\uc2ec \uc788\ub294 \uae00\uba38\ub9ac \uae30\ud638\ub97c \ud074\ub9ad\ud558\uc5ec \uc138\ubd80\uc815\ubcf4\ub85c \uc774\ub3d9\ud558\uc138\uc694."}, "1757": {"message": "AI \uac1c\uc694\ub294 \ud559\uc220\uac80\uc0c9\uc5d0\uc11c \uc120\ud0dd\ud55c \uc5f0\uad6c \uc790\ub8cc\uc5d0\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucef4\ud4e8\ud130 \ud504\ub85c\uadf8\ub7a8\uc5d0\uc11c \uc0dd\uc131\ub418\ub294 AI \uac1c\uc694\uc5d0\ub294 \ubd88\uc644\uc804\ud558\uac70\ub098 \ubd80\uc815\ud655\ud55c \uc815\ubcf4\uac00 \ud3ec\ud568\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}, "1758": {"message": "\uc2e0\uaddc"}, "1759": {"message": "AI \uac1c\uc694\ub97c \uc774 PDF\uc5d0 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."}, "1760": {"message": "AI \uac1c\uc694\ub294 \uc774 PDF\uc758 \ub2e4\ub978 \ubc84\uc804\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4."}, "1766": {"message": "Chrome \uc124\uc815"}, "1768": {"message": "\ub300\ubd80\ubd84\uc758 \ud559\uc220 \uc0ac\uc774\ud2b8\uc5d0\uc11c PDF\ub97c \uc5f4 \ub54c \uc790\ub3d9\uc73c\ub85c \ucc3e\uae30"}, "1773": {"message": "\ud558\uc774\ub7