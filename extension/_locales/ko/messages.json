{"1010": {"message": "\uc0c8\ub85c \ub9cc\ub4e4\uae30"}, "1109": {"message": "\uc774 \uac80\uc0c9\uc5b4\uc5d0 \ub300\ud55c \uac80\uc0c9\uacb0\uacfc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."}, "111": {"message": "\ud604\uc7ac \uc2dc\uc2a4\ud15c\uc774 \uc791\ub3d9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."}, "1301": {"message": "\uc124\uc815"}, "1343": {"message": "\ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0 \uc800\uc7a5\ub428"}, "1441": {"message": "\uc774\uc804"}, "1442": {"message": "\ub2e4\uc74c"}, "1462": {"message": "\ub2eb\uae30"}, "1463": {"message": "\uc81c\ucd9c"}, "1484": {"message": "\uc774\uc804 \ud398\uc774\uc9c0"}, "1485": {"message": "\ub2e4\uc74c \ud398\uc774\uc9c0"}, "1486": {"message": "\ucd95\uc18c"}, "1487": {"message": "\ud655\ub300"}, "1488": {"message": "\ub192\uc774\uc5d0 \ub9de\ucda4"}, "1489": {"message": "\ub108\ube44\uc5d0 \ub9de\ucda4"}, "1490": {"message": "\ud68c\uc804\ud558\uae30"}, "1491": {"message": "\ub0b4 \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0 \uc800\uc7a5"}, "1492": {"message": "\ub2e4\uc6b4\ub85c\ub4dc"}, "1493": {"message": "\uc778\uc1c4"}, "1494": {"message": "\ub354\ubcf4\uae30"}, "1513": {"message": "\uc378\ub124\uc77c"}, "1514": {"message": "\ubaa8\ub450 \uc811\uae30"}, "1515": {"message": "\ubaa8\ub450 \ud3bc\uce58\uae30"}, "1542": {"message": "Google \ud559\uc220 \uac80\uc0c9"}, "1617": {"message": "Google \uac80\uc0c9"}, "1618": {"message": "Google \ud559\uc220\uac80\uc0c9 \ub77c\uc774\ube0c\ub7ec\ub9ac"}, "1620": {"message": "\uacb0\uacfc\ub97c \uac00\uc838\uc624\ub294 \uc911\uc5d0 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."}, "1621": {"message": "\ud559\uc220\uac80\uc0c9\uc5d0\uc11c \uac80\uc0c9 \uc911..."}, "1623": {"message": "\ud559\uc220\uac80\uc0c9 \ub77c\uc774\ube0c\ub7ec\ub9ac\uc5d0 \uc800\uc7a5"}, "1626": {"message": "\ubb38\uc11c \uc18d\uc131"}, "1627": {"message": "Chrome \ubdf